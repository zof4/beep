#!/usr/bin/env node
import { stdin, stdout, stderr } from "node:process";
import { executeSandboxTool } from "../src/sandbox-tool-executor.mjs";
import { normalizeSandboxToolRequest } from "../src/sandbox-tool-protocol.mjs";

async function readStdin() {
  let input = "";
  stdin.setEncoding("utf8");
  for await (const chunk of stdin) input += chunk;
  return input;
}

async function writeStdoutLine(line) {
  await new Promise((resolve, reject) => {
    stdout.write(`${line}\n`, (error) => {
      if (error) reject(error);
      else resolve();
    });
  });
}

try {
  const input = await readStdin();
  const body = JSON.parse(input || "{}");
  const cwd = process.env.BEEP_SANDBOX_WORKSPACE || "/workspace";
  const request = normalizeSandboxToolRequest({
    ...body,
    cwd,
  });
  const result = await executeSandboxTool(request);
  await writeStdoutLine(JSON.stringify(result));
  process.exitCode = result.ok ? 0 : 2;
} catch (error) {
  stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
