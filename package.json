{
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:control-plane": "node --test control-plane/test/*.test.mjs",
    "test:first-usable-backend": "node --test test/*.test.mjs control-plane/test/*.test.mjs && bash -n scripts/smoke-test-first-usable-backend.sh",
    "test:hindsight": "node --test test/hindsight-service.test.mjs test/external-memory-hints.test.mjs test/memory-coordinator.test.mjs",
    "test:lcm": "node --test test/lcm-external-memory.test.mjs",
    "test:proof": "node --test test/proof-memory-lifecycle.test.mjs",
    "test:reconciliation": "node --test test/*.test.mjs control-plane/test/*.test.mjs",
    "test:host-loop-static": "node --test test/sandbox-tool-protocol.test.mjs test/sandbox-tool-executor.test.mjs test/sandbox-tool-portal-extension.test.mjs test/sandbox-tool-runner.test.mjs test/runtime-integration-static.test.mjs",
    "test:host-loop": "npm run test:host-loop-static && bash -n scripts/smoke-test-host-loop-sandbox.sh",
    "test:runtime-static": "node --test test/runtime-integration-static.test.mjs"
  }
}
